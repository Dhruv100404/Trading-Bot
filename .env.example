# Required
DHAN_ACCESS_TOKEN=your_token_here
DHAN_CLIENT_ID=your_client_id_here

# Optional overrides
DHAN_BASE_URL=https://api.dhan.co/v2
DHAN_QUOTE_ENDPOINT=/marketfeed/quote
DHAN_ORDERS_ENDPOINT=/orders
DHAN_POSITIONS_ENDPOINT=/positions

# Optional Telegram trigger alerts
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Market command center refreshers
NEWS_AUTO_REFRESH=true
NEWS_REFRESH_INTERVAL_SECS=900
NEWS_MAX_PER_SOURCE=40
NEWS_SOURCES=
NSE_LARGE_DEALS_LOOKBACK_DAYS=7

MARKET_ACTIVITY_AUTO_REFRESH=true
MARKET_ACTIVITY_REFRESH_INTERVAL_SECS=900
MARKET_ACTIVITY_MAX_ROWS_PER_SOURCE=75
MARKET_ACTIVITY_SOURCES=

# Set to true to log raw API responses
DEBUG=false
